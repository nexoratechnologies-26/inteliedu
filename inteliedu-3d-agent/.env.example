# ==============================================================================
# INTELIEDU 3D GENERATION AGENT - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real API keys or service-role secrets.
# ==============================================================================

APP_ENV=development
APP_PORT=8001
APP_HOST=0.0.0.0
AGENT_API_PREFIX=/api/v1/3d-agent
LOG_LEVEL=INFO

# Internal service auth (optional shared bearer token between Express backend & 3D agent)
AGENT_API_KEY=

# LLM Provider Configuration (supports Groq, Gemini, or OpenAI-compatible endpoints)
# Note: GROQ_API_KEY from root .env is automatically recognized if LLM_API_KEY is unset.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_API_KEY=

# Blender & Blender MCP Configuration (local CLI, stdio MCP, or remote Streamable HTTP MCP)
BLENDER_EXECUTABLE_PATH=C:/Program Files/Blender Foundation/Blender 4.3/blender.exe
BLENDER_MCP_URL=
BLENDER_MCP_TOKEN=
BLENDER_MCP_COMMAND=uvx
BLENDER_MCP_ARGS=mcp-for-blender
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9876
BLENDER_RENDER_TIMEOUT_SECONDS=600
BLENDER_RENDER_ENGINE=BLENDER_EEVEE_NEXT
BLENDER_SAMPLES=16

# Runway API & Optional Runway MCP Configuration
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_API_VERSION=2024-11-06
RUNWAY_MODEL=gen4.5
RUNWAY_TIMEOUT_SECONDS=300
RUNWAY_MCP_URL=
RUNWAY_MCP_COMMAND=
RUNWAY_MCP_ARGS=
RUNWAY_MCP_TOKEN=

# FFmpeg / Video Defaults
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_DEFAULT_WIDTH=1920
VIDEO_DEFAULT_HEIGHT=1080
VIDEO_DEFAULT_FPS=30
VIDEO_MAX_SIZE_MB=250
VIDEO_ALLOW_UPSCALE=false

# Storage & Metadata Persistence
# Local directory used when cloud storage is not configured, and as staging dir.
GENERATED_DIR=./generated
STORAGE_PROVIDER=local
STORAGE_BUCKET=educational-videos
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GCS_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# PostgreSQL (falls back to local SQLite metadata store in generated/metadata.db when unset)
DATABASE_URL=

# Cost & Concurrency Guardrails
MAX_CONCURRENT_JOBS=2
ENABLE_VIDEO_CACHE=true
ALLOW_RUNWAY_FALLBACK=true
MAX_VIDEO_DURATION_SECONDS=300

